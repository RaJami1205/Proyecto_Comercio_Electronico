# CN-57. Nombres y defaults sin credenciales. Copiar las opciones necesarias a un entorno privado.
# URL runtime del Session Pooler, puerto 5432, usuario cibernova_app.<PROJECT_REF>.
# Sin parámetros SSL en la URL. Las credenciales privilegiadas de migrations se gestionan por separado.
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
# Contenido PEM completo, con saltos de línea reales. No es una ruta de archivo.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=3
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Integration Tests realizan escrituras. PROHIBIDO apuntarlos a Production o a un túnel hacia ella.
# Opt-in exclusivo para una base PostgreSQL aislada local con las migrations ya aplicadas.
RUN_DATABASE_INTEGRATION_TESTS=0
DATABASE_TEST_URL=
DATABASE_TEST_SSL_MODE=disable
